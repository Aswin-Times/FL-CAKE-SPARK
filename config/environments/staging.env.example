# Staging Environment Variables
NODE_ENV=staging
PORT=5000
NEXT_PUBLIC_API_URL=https://staging-api.cakespark.com/api

DATABASE_URL=postgresql://staging_user:staging_password@staging-db.cakespark.internal:5432/cake_spark_staging?schema=public&sslmode=require

RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder

CLOUDINARY_CLOUD_NAME=cake-spark-staging
CLOUDINARY_API_KEY=placeholder_api_key
CLOUDINARY_API_SECRET=placeholder_api_secret

EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USER=apikey
EMAIL_PASSWORD=placeholder_staging_key

WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_ACCESS_TOKEN=placeholder_staging_token
