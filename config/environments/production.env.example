# Production Environment Variables
NODE_ENV=production
PORT=5000
NEXT_PUBLIC_API_URL=https://api.cakespark.com/api

DATABASE_URL=postgresql://prod_user:prod_password@prod-db.cakespark.internal:5432/cake_spark_prod?schema=public&sslmode=require

RAZORPAY_KEY_ID=rzp_live_placeholder
RAZORPAY_KEY_SECRET=rzp_live_secret_placeholder

